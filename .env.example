# Select exactly one source mode. Zetaris mode never falls back to sample data.
CEREV_EVIDENCE_MODE=sample
CEREV_SAMPLE_STORE_DIR=.cerev/sample-sources

# Live managed Gateway UI proxy origin. Set the origin only; do not add a path.
ZETARIS_BASE_URL=
# Direct SaaS REST API URL retained for the separate direct REST client.
# The current evidence collector uses ZETARIS_BASE_URL (Gateway), not this URL.
ZETARIS_REST_URL=https://api.saas.enterprise.zetaris.com/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_ENGINE_ID=
CEREV_ZETARIS_TIMEOUT_SECONDS=30

# Gateway SQL Editor proxy response uses top-level data + headers.
# Keep the default unless the provisioned cluster documents another envelope.
CEREV_ZETARIS_ROWS_PATH=data

# Existing registered, read-only SQL relations for the canonical evidence groups.
# Use 2- or 3-part SQL identifiers, e.g. DATABASE.TABLE. No DDL is run by CEREV.
CEREV_ZETARIS_CONTRACT_RECORDS_TABLE=
CEREV_ZETARIS_CMS_POLICIES_TABLE=
CEREV_ZETARIS_CMS_CLASSIFICATIONS_TABLE=
CEREV_ZETARIS_MAINTENANCE_EVENTS_TABLE=
CEREV_ZETARIS_NOTICE_RECORDS_TABLE=
CEREV_ZETARIS_RELEASES_TABLE=
CEREV_ZETARIS_BILLING_CALCULATIONS_TABLE=
CEREV_ZETARIS_PROPOSED_ACTIONS_TABLE=
