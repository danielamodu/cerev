# Select exactly one source mode. Zetaris mode never falls back to sample data.
CEREV_EVIDENCE_MODE=sample
CEREV_SAMPLE_STORE_DIR=.cerev/sample-sources

# Live managed Gateway UI proxy origin. Set the origin only; do not add a path.
ZETARIS_BASE_URL=
# Direct SaaS REST API URL retained for the separate direct REST client.
# The current evidence collector uses ZETARIS_BASE_URL (Gateway), not this URL.
ZETARIS_REST_URL=https://api.saas.enterprise.zetaris.com/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_ENGINE_ID=
CEREV_ZETARIS_TIMEOUT_SECONDS=30

# Gateway SQL Editor proxy response uses top-level data + headers.
# Keep the default unless the provisioned cluster documents another envelope.
CEREV_ZETARIS_ROWS_PATH=data

# Read-only SQL relation bindings for the manually registered, Phase 12.7
# verified simulation transports. Several categories intentionally share one
# relation; CEREV validates the whole relation inventory, then selects only the
# categories assigned to each logical source. Use qualified SQL identifiers.
CEREV_ZETARIS_CONTRACT_RECORDS_TABLE=cerev_contract_records_v1.cerev_contract_records_v1
CEREV_ZETARIS_CMS_POLICIES_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_CMS_CLASSIFICATIONS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_MAINTENANCE_EVENTS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_NOTICE_RECORDS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_RELEASES_TABLE=cerev_phase124.cerev_releases
CEREV_ZETARIS_BILLING_CALCULATIONS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_PROPOSED_ACTIONS_TABLE=cerev_phase124.cerev_main
