# =====================================================================
# Zetaris Model Context Protocol (MCP) Server Configuration
# =====================================================================

# Live managed Gateway UI proxy origin. Set the origin only; do not add a path.
ZETARIS_BASE_URL=https://new-ui.6bafd68f-fe52-4a14-b3a1-80bd81c2ff50.cloud.zetaris.com
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your_zetaris_api_key_here
ZETARIS_ENGINE_ID=
ZETARIS_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------
# Security Controls & Boundary Enforcement
# ---------------------------------------------------------------------

# Comma-separated list of allowed datasets/schemas for list_datasets & queries.
ZETARIS_MCP_ALLOWED_DATASETS=cerev_contract_records_v1,cerev_phase124

# Comma-separated list of approved fully qualified tables for execute_query.
ZETARIS_MCP_ALLOWED_TABLES=cerev_contract_records_v1.cerev_contract_records_v1,cerev_phase124.cerev_main,cerev_phase124.cerev_releases,cerev_phase124.cerev_contract_records

# Maximum rows allowed per query execution (hard ceiling).
ZETARIS_MCP_MAX_ROWS=100

# Maximum response size in bytes (default: 5 MB).
ZETARIS_MCP_MAX_RESPONSE_BYTES=5242880

# In-memory query result cache configuration (for inspect_query_result).
ZETARIS_MCP_CACHE_SIZE=100
ZETARIS_MCP_CACHE_TTL_SECONDS=1800

# ---------------------------------------------------------------------
# CEREV Logical Source Relation Mappings
# ---------------------------------------------------------------------
CEREV_ZETARIS_CONTRACT_RECORDS_TABLE=cerev_contract_records_v1.cerev_contract_records_v1
CEREV_ZETARIS_CMS_POLICIES_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_CMS_CLASSIFICATIONS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_MAINTENANCE_EVENTS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_NOTICE_RECORDS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_RELEASES_TABLE=cerev_phase124.cerev_releases
CEREV_ZETARIS_BILLING_CALCULATIONS_TABLE=cerev_phase124.cerev_main
CEREV_ZETARIS_PROPOSED_ACTIONS_TABLE=cerev_phase124.cerev_main
